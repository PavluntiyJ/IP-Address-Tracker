# Used by the Netlify Function during local development.
IPIFY_API_KEY=your_ipify_api_key

# Leave empty to use the same-origin /api/lookup endpoint.
# For a deployed frontend, set the public Worker endpoint, for example:
# VITE_API_URL=https://ip-address-tracker-api.your-account.workers.dev/api/lookup
VITE_API_URL=
